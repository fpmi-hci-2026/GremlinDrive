@startuml
!include <C4/C4_Context>
title C4: контекст системы GremlinDrive

Person(user, "Пользователь", "Студент, сотрудник, фрилансер или преподаватель. Работает с файлами через веб и мобильное приложение.")
Person(guest, "Гость", "Открывает публичную ссылку и скачивает файл без регистрации.")
Person(admin, "Администратор", "Управляет пользователями, квотами, правами и аудитом.")

System(drive, "GremlinDrive", "Облачное файловое хранилище: файлы, папки, версии, ссылки, совместная работа и администрирование.")

System_Ext(smtp, "SMTP-сервер", "Отправка писем: подтверждение e-mail, приглашения, ссылки.")
System_Ext(push, "FCM / APNs", "Push-уведомления мобильных приложений.")
System_Ext(ldap, "LDAP / Active Directory", "Корпоративный каталог пользователей.")
System_Ext(idp, "OAuth-провайдер", "Вход через внешний аккаунт (опционально).")

Rel(user, drive, "Загружает, хранит, ищет и передаёт файлы", "HTTPS")
Rel(guest, drive, "Открывает ссылку и скачивает файл", "HTTPS")
Rel(admin, drive, "Управляет системой и аудитом", "HTTPS")
Rel(drive, smtp, "Отправляет письма", "SMTP/TLS")
Rel(drive, push, "Отправляет push-уведомления", "HTTPS")
Rel(drive, ldap, "Синхронизирует пользователей и группы", "LDAPS")
Rel(user, idp, "Проходит аутентификацию (опционально)", "OAuth 2.0")
Rel(drive, idp, "Проверяет токены", "OAuth 2.0")
@enduml
