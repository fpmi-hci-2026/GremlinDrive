erDiagram
  USERS ||--o{ SESSIONS : has
  USERS ||--o{ USER_ROLES : has
  ROLES ||--o{ USER_ROLES : includes
  USERS ||--o{ FOLDERS : owns
  USERS ||--o{ FILES : owns
  FOLDERS ||--o{ FOLDERS : contains
  FOLDERS ||--o{ FILES : contains
  FILES ||--o{ FILE_VERSIONS : has
  FILES ||--o{ SHARE_LINKS : shared_by
  FOLDERS ||--o{ SHARE_LINKS : shared_by
  FILES ||--o{ ACCESS_PERMISSIONS : grants
  FOLDERS ||--o{ ACCESS_PERMISSIONS : grants
  USERS ||--o{ ACCESS_PERMISSIONS : receives
  FOLDERS ||--o{ FOLDER_MEMBERS : includes
  USERS ||--o{ FOLDER_MEMBERS : joins
  FOLDERS ||--o{ INVITATIONS : sends
  USERS ||--o{ ACCESS_REQUESTS : creates
  USERS ||--|| QUOTAS : has
  USERS ||--o{ AUDIT_RECORDS : performs
  USERS ||--o{ NOTIFICATIONS : receives
  FILES ||--o{ COMMENTS : has
  USERS ||--o{ COMMENTS : writes

  USERS {
    uuid id PK
    string email UK
    string password_hash
    string name
    string status
    timestamp created_at
  }
  ROLES {
    int id PK
    string code UK
    string title
  }
  USER_ROLES {
    uuid user_id FK
    int role_id FK
  }
  FOLDERS {
    uuid id PK
    uuid owner_id FK
    uuid parent_id FK
    string name
    bool is_shared
  }
  FILES {
    uuid id PK
    uuid owner_id FK
    uuid folder_id FK
    string name
    string mime_type
    bigint size_bytes
    string status
  }
  FILE_VERSIONS {
    uuid id PK
    uuid file_id FK
    int version_no
    string storage_key
    bigint size_bytes
  }
  SHARE_LINKS {
    uuid id PK
    uuid file_id FK
    uuid folder_id FK
    string token UK
    string access_level
    timestamp expires_at
    int downloads
  }
  ACCESS_PERMISSIONS {
    uuid id PK
    uuid file_id FK
    uuid folder_id FK
    uuid user_id FK
    string level
  }
  FOLDER_MEMBERS {
    uuid folder_id FK
    uuid user_id FK
    string role
  }
  INVITATIONS {
    uuid id PK
    uuid folder_id FK
    string email
    string token UK
    string status
  }
  ACCESS_REQUESTS {
    uuid id PK
    uuid user_id FK
    string type
    string status
    uuid decided_by FK
  }
  QUOTAS {
    uuid user_id PK
    bigint used_bytes
    bigint total_bytes
    string tariff
  }
  AUDIT_RECORDS {
    bigint id PK
    uuid user_id FK
    string action
    timestamp created_at
  }
  NOTIFICATIONS {
    uuid id PK
    uuid user_id FK
    string type
    bool is_read
  }
  COMMENTS {
    uuid id PK
    uuid file_id FK
    uuid author_id FK
    string text
  }
