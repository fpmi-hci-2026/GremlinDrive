@startuml
!pragma layout smetana
skinparam backgroundColor white
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 15
skinparam shadowing false
skinparam roundcorner 5
skinparam linetype ortho
skinparam classBackgroundColor #F6F8F7
skinparam classBorderColor #1F7A4B
hide circle
title GremlinDrive PostgreSQL 16
entity "users" as users {
  * id : uuid <<PK>>
  email : varchar(255)
  password_hash : text
  name : varchar(120)
  status : varchar(20)
  locale : varchar(10)
  created_at : timestamptz
}
entity "roles" as roles {
  * id : smallint <<PK>>
  code : varchar(20)
  title : varchar(60)
}
entity "user_roles" as user_roles {
  * user_id : uuid <<PK,FK>>
  * role_id : smallint <<PK,FK>>
}
entity "sessions" as sessions {
  * id : uuid <<PK>>
  user_id : uuid <<FK>>
  token_hash : char(64)
  ip_address : inet
  expires_at : timestamptz
  created_at : timestamptz
}
entity "folders" as folders {
  * id : uuid <<PK>>
  owner_id : uuid <<FK>>
  parent_id : uuid <<FK>>
  name : varchar(255)
  is_shared : boolean
  created_at : timestamptz
}
entity "files" as files {
  * id : uuid <<PK>>
  owner_id : uuid <<FK>>
  folder_id : uuid <<FK>>
  name : varchar(255)
  mime_type : varchar(127)
  size_bytes : bigint
  checksum : char(64)
  status : varchar(20)
  trashed_at : timestamptz
  created_at : timestamptz
}
entity "file_versions" as file_versions {
  * id : uuid <<PK>>
  file_id : uuid <<FK>>
  version_no : integer
  storage_key : varchar(512)
  size_bytes : bigint
  checksum : char(64)
  created_by : uuid <<FK>>
  created_at : timestamptz
  comment : text
}
entity "share_links" as share_links {
  * id : uuid <<PK>>
  file_id : uuid <<FK>>
  folder_id : uuid <<FK>>
  token_hash : char(64)
  access_level : varchar(10)
  password_hash : text
  expires_at : timestamptz
  revoked_at : timestamptz
  download_limit : integer
  downloads : integer
  created_by : uuid <<FK>>
  created_at : timestamptz
}
entity "access_permissions" as access_permissions {
  * id : uuid <<PK>>
  file_id : uuid <<FK>>
  folder_id : uuid <<FK>>
  user_id : uuid <<FK>>
  level : varchar(10)
  granted_at : timestamptz
}
entity "folder_members" as folder_members {
  * folder_id : uuid <<PK,FK>>
  * user_id : uuid <<PK,FK>>
  role : varchar(10)
  invited_at : timestamptz
}
entity "invitations" as invitations {
  * id : uuid <<PK>>
  folder_id : uuid <<FK>>
  email : varchar(255)
  token_hash : char(64)
  level : varchar(10)
  status : varchar(20)
  expires_at : timestamptz
  invited_by : uuid <<FK>>
  created_at : timestamptz
}
entity "access_requests" as access_requests {
  * id : uuid <<PK>>
  user_id : uuid <<FK>>
  type : varchar(20)
  reason : text
  requested_bytes : bigint
  requested_role : varchar(20)
  status : varchar(20)
  decided_by : uuid <<FK>>
  decided_at : timestamptz
  decision_comment : text
  created_at : timestamptz
}
entity "quotas" as quotas {
  * user_id : uuid <<PK,FK>>
  used_bytes : bigint
  total_bytes : bigint
  reserved_bytes : bigint
  tariff : varchar(40)
  renewal_date : date
}
entity "audit_records" as audit_records {
  * id : bigint <<PK>>
  user_id : uuid <<FK>>
  action : varchar(80)
  entity_type : varchar(40)
  entity_id : uuid
  ip_address : inet
  created_at : timestamptz
}
entity "notifications" as notifications {
  * id : uuid <<PK>>
  user_id : uuid <<FK>>
  type : varchar(40)
  text : text
  is_read : boolean
  created_at : timestamptz
}
entity "comments" as comments {
  * id : uuid <<PK>>
  file_id : uuid <<FK>>
  author_id : uuid <<FK>>
  text : text
  created_at : timestamptz
}
entity "upload_sessions" as upload_sessions {
  * id : uuid <<PK>>
  user_id : uuid <<FK>>
  file_id : uuid <<FK>>
  expected_bytes : bigint
  received_bytes : bigint
  idempotency_key : uuid
  status : varchar(20)
  expires_at : timestamptz
}
files ||--o{ file_versions : file_id
users ||--o{ audit_records : user_id
folders ||--o{ share_links : folder_id
users ||--o{ folders : owner_id
folders ||--o{ folders : parent_id
users ||--o{ notifications : user_id
users ||--o{ comments : author_id
files ||--o{ upload_sessions : file_id
folders ||--o{ files : folder_id
users ||--o{ sessions : user_id
users ||--o{ share_links : created_by
files ||--o{ access_permissions : file_id
folders ||--o{ folder_members : folder_id
users ||--o{ folder_members : user_id
users ||--o{ access_requests : decided_by
users ||--o{ files : owner_id
files ||--o{ comments : file_id
users ||--o| quotas : user_id
folders ||--o{ access_permissions : folder_id
users ||--o{ file_versions : created_by
folders ||--o{ invitations : folder_id
users ||--o{ access_permissions : user_id
users ||--o{ access_requests : user_id
users ||--o{ user_roles : user_id
roles ||--o{ user_roles : role_id
users ||--o{ upload_sessions : user_id
files ||--o{ share_links : file_id
users ||--o{ invitations : invited_by
@enduml
