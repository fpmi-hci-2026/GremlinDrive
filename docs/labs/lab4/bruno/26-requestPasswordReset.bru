meta {
  name: requestPasswordReset
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/api/v1/auth/password-resets
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "email": "student@example.test"
  }
}

tests {
  test("Success response", function () { expect(res.status).to.be.within(200, 299); });
}
