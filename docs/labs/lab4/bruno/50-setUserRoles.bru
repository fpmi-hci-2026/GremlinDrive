meta {
  name: setUserRoles
  type: http
  seq: 50
}

put {
  url: {{baseUrl}}/api/v1/admin/users/00000000-0000-4000-8000-000000000001/roles
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "roles": [
      "user"
    ]
  }
}

tests {
  test("Success response", function () { expect(res.status).to.be.within(200, 299); });
}
