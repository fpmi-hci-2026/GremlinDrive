meta {
  name: setUserStatus
  type: http
  seq: 49
}

patch {
  url: {{baseUrl}}/api/v1/admin/users/00000000-0000-4000-8000-000000000001
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "status": "blocked"
  }
}

tests {
  test("Success response", function () { expect(res.status).to.be.within(200, 299); });
}
